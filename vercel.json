{
  "functions": {
    "api/upload.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/upload-url.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "routes": [
    {
      "src": "^/$",
      "dest": "/api/home.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
